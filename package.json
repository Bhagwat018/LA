{
  "name": "linkedin-growth-agent",
  "version": "1.0.0",
  "description": "AI Autonomous LinkedIn Agent for Freelance Leads, Part-Time Projects & High-Match Jobs",
  "main": "scripts/login.mjs",
  "type": "module",
  "scripts": {
    "login": "node scripts/login.mjs",
    "find:freelance": "node scripts/find-freelance.mjs",
    "outreach": "node scripts/send-outreach.mjs",
    "inbox": "node scripts/check-inbox.mjs",
    "daily": "node scripts/daily-pipeline.mjs",
    "daemon": "node scripts/scheduler.mjs",
    "schedule:install": "bash scripts/setup-launchd.sh",
    "schedule:uninstall": "bash scripts/setup-launchd.sh --uninstall",
    "apply:jobs": "node scripts/apply-jobs.mjs"
  },
  "keywords": [
    "linkedin",
    "freelance",
    "ai-agent",
    "automation",
    "playwright"
  ],
  "author": "Bhagwat",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.10",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.0",
    "playwright": "^1.65.1"
  }
}
