# =======================================================
# 🚀 LinkedIn Autonomous Agent - Configuration (.env)
# =======================================================

# -------------------------------------------------------
# 📧 Cold Email Outreach Settings (Nodemailer / SMTP)
# When a recruiter/founder's post includes an email address,
# the agent automatically sends a professional project pitch.
# -------------------------------------------------------
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
FROM_EMAIL="Bhagwat <your_email@gmail.com>"

# -------------------------------------------------------
# 🛡️ Browser & Safety Settings
# -------------------------------------------------------
# Set to true for silent background operation without opening windows
HEADLESS=true

# Maximum connection requests / DMs per daily batch (Recommended: 5-8)
MAX_OUTREACH_PER_RUN=5

# Maximum cold emails sent per run
MAX_EMAILS_PER_RUN=5
