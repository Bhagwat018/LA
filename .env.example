# =======================================================
# 🚀 LinkedIn Autonomous Agent - Configuration Template (.env.example)
# Copy this file to .env and fill in your private credentials.
# =======================================================

# -------------------------------------------------------
# 🧠 Google Gemini AI Engine (For Hyper-Personalized Pitches)
# -------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------
# 📧 Cold Email Outreach Settings (Nodemailer / SMTP)
# -------------------------------------------------------
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
FROM_EMAIL="Gopal Bhagwat <your_email@gmail.com>"

# -------------------------------------------------------
# 🛡️ Browser & Safety Settings
# -------------------------------------------------------
HEADLESS=true
MAX_OUTREACH_PER_RUN=5
MAX_EMAILS_PER_RUN=5
